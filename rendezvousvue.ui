    <string>#centralwidget { background-color:#F4F8F8; }

/* ----- Champs de saisie (style commun à toute l'application) ----- */
QLineEdit, QComboBox, QSpinBox, QDoubleSpinBox, QDateEdit {
  border:1px solid #D5E0E0; border-radius:6px; padding:0 10px;
  background:white; color:#1E3A3A; font-size:13px; min-height:30px; }
QLineEdit:focus, QComboBox:focus, QSpinBox:focus, QDoubleSpinBox:focus, QDateEdit:focus {
  border:1px solid #2A8C86; }
QComboBox::drop-down, QDateEdit::drop-down {
  subcontrol-origin:padding; subcontrol-position:center right; width:30px; border:none; }
QComboBox::down-arrow, QDateEdit::down-arrow {
  image:url(:/icones/fleche_bas.png); width:12px; height:12px; }
QComboBox QAbstractItemView {
  background:white; color:#1E3A3A; border:1px solid #D5E0E0; outline:0; padding:4px;
  selection-background-color:#E6F2F1; selection-color:#1E3A3A; }
QComboBox QAbstractItemView::item {
  min-height:30px; padding-left:8px; color:#1E3A3A; background:white; }
QComboBox QAbstractItemView::item:hover, QComboBox QAbstractItemView::item:selected {
  background:#E6F2F1; color:#1E3A3A; }
QSpinBox::up-button, QDoubleSpinBox::up-button {
  subcontrol-origin:border; subcontrol-position:top right; width:28px;
  border:none; border-left:1px solid #E0E8E8; border-top-right-radius:6px; }
QSpinBox::down-button, QDoubleSpinBox::down-button {
  subcontrol-origin:border; subcontrol-position:bottom right; width:28px;
  border:none; border-left:1px solid #E0E8E8; border-bottom-right-radius:6px; }
QSpinBox::up-button:hover, QDoubleSpinBox::up-button:hover,
QSpinBox::down-button:hover, QDoubleSpinBox::down-button:hover { background:#E6F2F1; }
QSpinBox::up-arrow, QDoubleSpinBox::up-arrow { image:url(:/icones/fleche_haut.png); width:10px; height:10px; }
QSpinBox::down-arrow, QDoubleSpinBox::down-arrow { image:url(:/icones/fleche_bas.png); width:10px; height:10px; }

/* ----- Barre de défilement ----- */
QScrollArea { background:transparent; border:none; }
QScrollBar:vertical { background:transparent; width:10px; margin:0; }
QScrollBar::handle:vertical { background:#C5D6D5; border-radius:5px; min-height:40px; }
QScrollBar::handle:vertical:hover { background:#2A8C86; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height:0; }
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical { background:none; }
QScrollBar:horizontal { background:transparent; height:10px; margin:0; }
QScrollBar::handle:horizontal { background:#C5D6D5; border-radius:5px; min-width:40px; }
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal { width:0; }

/* ----- Page Commandes ----- */
QFrame#frameFormCommande, QFrame#frameDetailsCommande { background:white; border:1px solid #E0E8E8; border-radius:10px; }
QLabel#lblTitreFormCommande, QLabel#lblTitreDetailsCommande {
  background:#2A8C86; color:white; font-weight:bold; font-size:14px; padding:11px 18px;
  border:none; border-top-left-radius:10px; border-top-right-radius:10px; }
QLabel#lblChamp0Commande, QLabel#lblChamp1Commande, QLabel#lblChamp2Commande,
QLabel#lblChamp3Commande, QLabel#lblChamp4Commande { color:#6B8080; font-size:12px; border:none; background:transparent; }
QLabel#lblDetCle0Commande, QLabel#lblDetCle1Commande, QLabel#lblDetCle2Commande, QLabel#lblDetCle3Commande,
QLabel#lblDetCle4Commande, QLabel#lblDetCle5Commande, QLabel#lblDetCle6Commande { color:#6B8080; font-size:13px; border:none; background:transparent; }
QLabel#lblDetVal0Commande, QLabel#lblDetVal1Commande, QLabel#lblDetVal2Commande,
QLabel#lblDetVal4Commande, QLabel#lblDetVal5Commande, QLabel#lblDetVal6Commande { color:#17363A; font-size:13px; font-weight:bold; border:none; background:transparent; }
QLabel#lblStatutCommande, QLabel#lblTriCommande { color:#1E3A3A; font-size:13px; }
QPushButton#btnAjouterCommande, QPushButton#btnEnregistrerCommande, QPushButton#btnExporterCommande {
  background:#2A8C86; color:white; border:none; border-radius:8px; font-weight:bold; font-size:13px; padding:0 18px; }
QPushButton#btnAjouterCommande:hover, QPushButton#btnEnregistrerCommande:hover, QPushButton#btnExporterCommande:hover { background:#1F6F6B; }
QPushButton#btnAnnulerCommande { background:white; color:#2A8C86; border:1px solid #2A8C86; border-radius:8px; font-weight:bold; font-size:13px; }
QPushButton#btnAnnulerCommande:hover { background:#E6F2F1; }
QTableView#tableCommande { background:white; color:#1E3A3A; font-size:13px; border:1px solid #E0E8E8; border-radius:10px;
  selection-background-color:#E6F2F1; selection-color:#1E3A3A; }
QTableView#tableCommande QHeaderView::section { background:white; color:#17363A; font-weight:bold; padding:10px 8px; border:none; border-bottom:1px solid #E0E8E8; }
QCalendarWidget QWidget { background-color:white; color:#1E3A3A; }
QCalendarWidget QToolButton { color:#17363A; background-color:white; font-weight:bold; }
QCalendarWidget QAbstractItemView:enabled { background-color:white; color:#1E3A3A; selection-background-color:#2A8C86; selection-color:white; }
QCalendarWidget QAbstractItemView:disabled { color:#9BB0B0; }
QMessageBox { background-color:white; }
QMessageBox QLabel { color:#1E3A3A; }
QMessageBox QPushButton { background-color:#2A8C86; color:white; border:none; border-radius:6px; padding:6px 18px; min-width:70px; font-weight:bold; }
QMessageBox QPushButton:hover { background-color:#1F6F6B; }

QToolTip { background:white; color:#1E3A3A; border:1px solid #D5E0E0; padding:4px; }</string>
