         <widget class="QWidget" name="pageRendezVous"><property name="styleSheet"><string notr="true">QWidget#pageRendezVous { background-color: #F4F8F8; }
QLabel { background: transparent; color: #1E3A3A; }

/* champs de saisie */
QLineEdit, QComboBox, QDateEdit, QTimeEdit {
    border: 1px solid #D5E0E0; border-radius: 6px; padding: 0 10px;
    background: white; color: #1E3A3A; font-size: 13px; min-height: 30px; }
QLineEdit:focus, QComboBox:focus, QDateEdit:focus, QTimeEdit:focus { border: 1px solid #2A8C86; }
QComboBox::drop-down, QDateEdit::drop-down {
    subcontrol-origin: padding; subcontrol-position: center right; width: 30px; border: none; }
QComboBox::down-arrow, QDateEdit::down-arrow {
    image: url(:/icones/fleche_bas.png); width: 12px; height: 12px; }
QTimeEdit::up-button { subcontrol-origin: border; subcontrol-position: top right; width: 24px; border: none; }
QTimeEdit::down-button { subcontrol-origin: border; subcontrol-position: bottom right; width: 24px; border: none; }
QTimeEdit::up-arrow { image: url(:/icones/fleche_haut.png); width: 10px; height: 10px; }
QTimeEdit::down-arrow { image: url(:/icones/fleche_bas.png); width: 10px; height: 10px; }
QComboBox QAbstractItemView {
    background: white; color: #1E3A3A; border: 1px solid #D5E0E0; outline: 0; padding: 4px;
    selection-background-color: #E6F2F1; selection-color: #1E3A3A; }
QComboBox QAbstractItemView::item { min-height: 30px; padding-left: 8px; color: #1E3A3A; background: white; }
QComboBox QAbstractItemView::item:hover, QComboBox QAbstractItemView::item:selected {
    background: #E6F2F1; color: #1E3A3A; }
QCalendarWidget QWidget { background-color: white; color: #1E3A3A; }
QCalendarWidget QToolButton { color: #17363A; background-color: white; font-weight: bold; }
QCalendarWidget QAbstractItemView:enabled {
    background-color: white; color: #1E3A3A; selection-background-color: #2A8C86; selection-color: white; }
QCalendarWidget QAbstractItemView:disabled { color: #9BB0B0; }

/* cadres : formulaire et détails */
QFrame#frameFormRdv, QFrame#frameDetailsRdv {
    background: white; border: 1px solid #E0E8E8; border-radius: 10px; }
QLabel#lblTitreFormRdv, QLabel#lblTitreDetailsRdv {
    background: #2A8C86; color: white; font-weight: bold; font-size: 14px; padding: 11px 18px;
    border: none; border-top-left-radius: 10px; border-top-right-radius: 10px; }
QLabel#lblChamp0Rdv, QLabel#lblChamp1Rdv, QLabel#lblChamp2Rdv,
QLabel#lblChamp3Rdv, QLabel#lblChamp4Rdv, QLabel#lblChamp5Rdv {
    color: #6B8080; font-size: 12px; border: none; background: transparent; }
QLabel#lblDetCle0Rdv, QLabel#lblDetCle1Rdv, QLabel#lblDetCle2Rdv, QLabel#lblDetCle3Rdv,
QLabel#lblDetCle4Rdv, QLabel#lblDetCle5Rdv, QLabel#lblDetCle6Rdv {
    color: #6B8080; font-size: 13px; border: none; background: transparent; }
QLabel#lblDetVal0Rdv, QLabel#lblDetVal1Rdv, QLabel#lblDetVal2Rdv,
QLabel#lblDetVal4Rdv, QLabel#lblDetVal5Rdv, QLabel#lblDetVal6Rdv {
    color: #17363A; font-size: 13px; font-weight: bold; border: none; background: transparent; }

/* boutons */
QPushButton#btnAjouterRdv, QPushButton#btnEnregistrerRdv, QPushButton#btnExporterRdv {
    background: #2A8C86; color: white; border: none; border-radius: 8px;
    font-weight: bold; font-size: 13px; padding: 0 18px; }
QPushButton#btnAjouterRdv:hover, QPushButton#btnEnregistrerRdv:hover,
QPushButton#btnExporterRdv:hover { background: #1F6F6B; }
QPushButton#btnAnnulerRdv {
    background: white; color: #2A8C86; border: 1px solid #2A8C86; border-radius: 8px;
    font-weight: bold; font-size: 13px; }
QPushButton#btnAnnulerRdv:hover { background: #E6F2F1; }

/* tableau */
QTableView#tableRdv {
    background: white; color: #1E3A3A; font-size: 13px; border: 1px solid #E0E8E8;
    border-radius: 10px; selection-background-color: #E6F2F1; selection-color: #1E3A3A; }
QTableView#tableRdv QHeaderView::section {
    background: white; color: #17363A; font-weight: bold; padding: 10px 8px;
    border: none; border-bottom: 1px solid #E0E8E8; }
QTableView#tableRdv QTableCornerButton::section { background: white; border: none; }
QScrollBar:vertical { background: transparent; width: 10px; margin: 0; }
QScrollBar::handle:vertical { background: #C5D6D5; border-radius: 5px; min-height: 40px; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical { background: none; }
