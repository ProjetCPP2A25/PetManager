                <item>
                 <widget class="QLabel" name="lblExplicationStock">
                  <property name="styleSheet">
                   <string>background:#E4F2F1; border:1px solid #CFE5E3; border-radius:10px; padding:12px; color:#1E3A3A; font-size:12px;</string>
                  </property>
                  <property name="text">
                   <string>&lt;b&gt;Comment ça marche ?&lt;/b&gt; Pour chaque produit, le système calcule la consommation moyenne des 30 derniers jours, prévoit la date de rupture (en tenant compte de la date d'expiration) et la compare au délai de livraison. Il propose ensuite la quantité à commander pour couvrir le délai et la période souhaitée. &lt;b&gt;Critique&lt;/b&gt; : rupture avant la livraison possible · &lt;b&gt;Urgent&lt;/b&gt; : quantité ≤ seuil · &lt;b&gt;Préventif&lt;/b&gt; : rupture prévue dans moins d'une semaine après le délai. Un produit déjà commandé n'est jamais proposé deux fois.</string>
                  </property>
                  <property name="textFormat">
                   <enum>Qt::RichText</enum>
                  </property>
                  <property name="wordWrap">
                   <bool>true</bool>
                  </property>
